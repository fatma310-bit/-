        "def show_grades(b=None):\n",
        "    clear_output(wait=True)\n",
        "\n",
        "    title_grades = widgets.HTML(\n",
        "        value=\"\"\"\n",
        "        <h2 style=\"text-align:center;\">\n",
        "            📝 درجات الطلاب\n",
        "        </h2>\n",
        "        \"\"\"\n",
        "    )\n",
        "\n",
        "    student_box = widgets.Dropdown(\n",
        "        options=list(students[\"اسم الطالب\"]),\n",
        "        description=\"الطالب:\"\n",
        "    )\n",
        "\n",
        "    exam_box = widgets.Dropdown(\n",
        "        options=[\n",
        "            \"الدوري الأول\",\n",
        "            \"نصف العام\",\n",
        "            \"الدوري الثاني\",\n",
        "            \"آخر العام\",\n",
        "            \"التفسير الأول\",\n",
        "            \"التفسير الثاني\",\n",
        "            \"التجويد\",\n",
        "            \"الغياب\",\n",
        "            \"السلوك\"\n",
        "        ],\n",
        "        description=\"المادة:\"\n",
        "    )\n",
        "\n",
        "    score_box = widgets.IntText(\n",
        "        value=0,\n",
        "        description=\"الدرجة:\"\n",
        "    )\n",
        "\n",
        "    save_btn = widgets.Button(\n",
        "        description=\"💾 حفظ الدرجة\",\n",
        "        button_style=\"success\"\n",
        "    )\n",
        "\n",
        "    back_btn = widgets.Button(\n",
        "        description=\"⬅️ الرئيسية\"\n",
        "    )\n",
        "\n",
        "    result = widgets.Output()\n",
        "\n",
        "    def save_grade(b):\n",
        "        with result:\n",
        "            clear_output()\n",
        "\n",
        "            if len(students) == 0:\n",
        "                print(\"❌ لا يوجد طلاب.\")\n",
        "                return\n",
        "\n",
        "            student_name = student_box.value\n",
        "            exam_name = exam_box.value\n",
        "            score = score_box.value\n",
        "\n",
        "            # الحدود القصوى للدرجات\n",
        "            max_scores = {\n",
        "                \"الدوري الأول\": 40,\n",
        "                \"نصف العام\": 100,\n",
        "                \"الدوري الثاني\": 40,\n",
        "                \"آخر العام\": 100,\n",
        "                \"التفسير الأول\": 10,\n",
        "                \"التفسير الثاني\": 10,\n",
        "                \"التجويد\": 10,\n",
        "                \"الغياب\": 10,\n",
        "                \"السلوك\": 10\n",
        "            }\n",
        "\n",
        "            maximum = max_scores[exam_name]\n",
        "\n",
        "            if score < 0 or score > maximum:\n",
        "                print(f\"⚠️ الدرجة يجب أن تكون من 0 إلى {maximum}.\")\n",
        "                return\n",
        "\n",
        "            index = students.index[\n",
        "                students[\"اسم الطالب\"] == student_name\n",
        "            ][0]\n",
        "\n",
        "            students.loc[index, exam_name] = score\n",
        "\n",
        "            # حساب المجموع\n",
        "            total = sum(\n",
        "                students.loc[index, subject]\n",
        "                for subject in max_scores\n",
        "            )\n",
        "\n",
        "            students.loc[index, \"المجموع\"] = total\n",
        "            students.loc[index, \"التقدير\"] = get_grade(total)\n",
        "\n",
        "            print(\"✅ تم حفظ الدرجة بنجاح!\")\n",
        "            print(f\"الطالب: {student_name}\")\n",
        "            print(f\"{exam_name}: {score} من {maximum}\")\n",
        "            print(f\"المجموع: {total}\")\n",
        "            print(f\"التقدير: {get_grade(total)}\")\n",
        "\n",
        "    save_btn.on_click(save_grade)\n",
        "    back_btn.on_click(show_home)\n",
        "\n",
        "    display(title_grades)\n",
        "    display(student_box)\n",
        "    display(exam_box)\n",
        "    display(score_box)\n",
        "    display(save_btn)\n",
        "    display(back_btn)\n",
        "    display(result)\n",
        "\n",
        "\n",
        "# ربط زر الدرجات بالواجهة الجديدة\n",
        "grades_btn._click_handlers.callbacks = []\n",
        "grades_btn.on_click(show_grades)\n",
        "\n",
