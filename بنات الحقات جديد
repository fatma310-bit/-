        "\n",
        "rate_box = widgets.BoundedFloatText(\n",
        "    value=0, min=0,\n",
        "    description=\"أجر الحلقة:\"\n",
        ")\n",
        "\n",
        "monthly_box = widgets.BoundedFloatText(\n",
