    {
      "cell_type": "code",
      "source": [
        "\n",
        "import pandas as pd\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import display, clear_output\n",
        "\n",
        "# الدرجات النهائية المعتمدة\n",
        "max_scores = {\n",
        "    \"الدوري الأول\": 40,\n",
        "    \"نصف العام\": 100,\n",
        "    \"الدوري الثاني\": 40,\n",
        "    \"آخر العام\": 100,\n",
        "    \"التفسير الأول\": 20,\n",
        "    \"التفسير الثاني\": 20,\n",
        "    \"التجويد\": 20,\n",
        "    \"الغياب\": 10,\n",
        "    \"السلوك\": 10\n",
        "}\n",
        "\n",
        "المجموع_الكلي = sum(max_scores.values())\n",
        "\n",
        "# التأكد من وجود أعمدة الدرجات\n",
        "for المادة in max_scores:\n",
        "    if المادة not in students.columns:\n",
        "        students[المادة] = 0\n",
        "\n",
        "for العمود in [\"المجموع\", \"النسبة %\", \"التقدير\"]:\n",
        "    if العمود not in students.columns:\n",
        "        students[العمود] = 0\n",
        "\n",
        "def حساب_التقدير(النسبة):\n",
        "    if النسبة >= 90:\n",
        "        return \"ممتاز\"\n",
        "    elif النسبة >= 80:\n",
        "        return \"جيد جدًا\"\n",
        "    elif النسبة >= 70:\n",
        "        return \"جيد\"\n",
        "    elif النسبة >= 60:\n",
        "        return \"مقبول\"\n",
        "    return \"يحتاج متابعة\"\n",
        "\n",
        "def تحديث_نتائج(رقم_الصف):\n",
        "    المجموع = sum(\n",
        "        pd.to_numeric(\n",
        "            pd.Series([students.loc[رقم_الصف, المادة]])\n",
        "        ).fillna(0).iloc[0]\n",
        "        for المادة in max_scores\n",
        "    )\n",
        "\n",
        "    النسبة = المجموع / المجموع_الكلي * 100\n",
        "\n",
        "    students.loc[رقم_الصف, \"المجموع\"] = المجموع\n",
        "    students.loc[رقم_الصف, \"النسبة %\"] = round(النسبة, 2)\n",
        "    students.loc[رقم_الصف, \"التقدير\"] = حساب_التقدير(النسبة)\n",
        "\n",
        "# اختيار الطالب\n",
        "student_box = widgets.Dropdown(\n",
        "    options=[\n",
        "        (str(row[\"اسم الطالب\"]), index)\n",
        "        for index, row in students.iterrows()\n",
        "    ] if \"اسم الطالب\" in students.columns else [],\n",
        "    description=\"الطالب:\",\n",
        "    layout=widgets.Layout(width=\"400px\")\n",
        ")\n",
        "\n",
        "# اختيار المادة\n",
        "exam_box = widgets.Dropdown(\n",
        "    options=list(max_scores.keys()),\n",
        "    description=\"المادة:\",\n",
        "    layout=widgets.Layout(width=\"400px\")\n",
        ")\n",
        "\n",
        "# خانة الدرجة\n",
        "score_box = widgets.BoundedFloatText(\n",
        "    value=0,\n",
        "    min=0,\n",
        "    max=40,\n",
        "    step=1,\n",
        "    description=\"الدرجة:\",\n",
        "    layout=widgets.Layout(width=\"300px\")\n",
        ")\n",
        "\n",
        "def تغيير_المادة(change):\n",
        "    if change[\"name\"] == \"value\" and change[\"new\"] is not None:\n",
        "        score_box.max = max_scores[change[\"new\"]]\n",
        "        score_box.value = 0\n",
        "\n",
        "exam_box.observe(تغيير_المادة)\n",
        "\n",
        "زر_الحفظ = widgets.Button(\n",
        "    description=\"حفظ الدرجة\",\n",
        "    button_style=\"success\",\n",
        "    icon=\"check\"\n",
        ")\n",
        "\n",
        "نتيجة = widgets.Output()\n",
        "\n",
        "def حفظ_الدرجة(b):\n",
        "    with نتيجة:\n",
        "        clear_output()\n",
        "\n",
        "        if student_box.value is None:\n",
        "            print(\"من فضلك أضيفي طالبًا أولًا.\")\n",
        "            return\n",
        "\n",
        "        الطالب = student_box.value\n",
        "        المادة = exam_box.value\n",
        "        الدرجة = score_box.value\n",
        "\n",
        "        if الدرجة < 0 or الدرجة > max_scores[المادة]:\n",
        "            print(\"الدرجة أكبر من الحد المسموح!\")\n",
        "            return\n",
        "\n",
        "        students.loc[الطالب, المادة] = الدرجة\n",
        "\n",
        "        تحديث_نتائج(الطالب)\n",
        "\n",
        "        print(\"تم حفظ الدرجة بنجاح ✅\")\n",
        "        print(\"اسم الطالب:\", students.loc[الطالب, \"اسم الطالب\"])\n",
        "        print(\"المادة:\", المادة)\n",
        "        print(\"الدرجة:\", الدرجة, \"من\", max_scores[المادة])\n",
        "        print(\"المجموع:\", students.loc[الطالب, \"المجموع\"])\n",
        "        print(\"النسبة:\", students.loc[الطالب, \"النسبة %\"], \"%\")\n",
        "        print(\"التقدير:\", students.loc[الطالب, \"التقدير\"])\n",
        "\n",
        "        display(students)\n",
        "\n",
        "زر_الحفظ.on_click(حفظ_الدرجة)\n",
        "\n",
        "print(\"📚 شاشة إدخال درجات الطلاب\")\n",
        "print(\"المجموع الكلي:\", المجموع_الكلي)\n",
        "\n",
        "display(student_box, exam_box, score_box, زر_الحفظ, نتيجة)\n"
      ],
