        "    description=\"الراتب الشهري:\"\n",
        ")\n",
        "\n",
        "days_box = widgets.BoundedIntText(\n",
        "    value=30, min=0, max=31,\n",
        "    description=\"أيام العمل:\"\n",
        ")\n",
        "\n",
        "month_days_box = widgets.BoundedIntText(\n",
        "    value=30, min=1, max=31,\n",
        "    description=\"أيام الشهر:\"\n",
