        "            أيام_الشهر = 30\n",
        "\n",
        "        else:\n",
        "            الراتب = monthly_box.value\n",
        "            الأيام = days_box.value\n",
        "            أيام_الشهر = month_days_box.value\n",
        "\n",
        "            if الراتب <= 0:\n",
