        "    elif score >= 80:\n",
        "        return \"جيد جدًا\"\n",
        "    elif score >= 70:\n",
        "        return \"جيد\"\n",
        "    elif score >= 60:\n",
        "        return \"مقبول\"\n",
        "    else:\n",
        "        return \"يحتاج متابعة\"\n",
        "\n",
        "students[\"التقدير\"] = students[\"المجموع\"].apply(get_grade)\n",
        "\n",
