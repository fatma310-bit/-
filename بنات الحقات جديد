        "        description=\"بحث:\",\n",
        "        layout=widgets.Layout(width=\"450px\")\n",
        "    )\n",
        "\n",
        "    نتيجة_البحث = widgets.Output()\n",
        "\n",
        "    def عرض_الكشف(_=None):\n",
        "\n",
        "        with نتيجة_البحث:\n",
        "            clear_output(wait=True)\n",
        "\n",
        "            if len(students) == 0:\n",
        "                print(\"لا يوجد طلاب مسجلون.\")\n",
        "                return\n",
        "\n",
        "            كشف = students.copy()\n",
        "\n",
        "            # البحث بالاسم أو رقم الحلقة\n",
        "            كلمة = بحث.value.strip()\n",
        "\n",
        "            if كلمة:\n",
        "                مطابقة = (\n",
        "                    كشف[\"اسم الطالب\"].astype(str).str.contains(\n",
        "                        كلمة, case=False, na=False\n",
        "                    )\n",
        "                    |\n",
        "                    كشف[\"رقم الحلقة\"].astype(str).str.contains(\n",
        "                        كلمة, case=False, na=False\n",
        "                    )\n",
        "                )\n",
        "                كشف = كشف[مطابقة]\n",
        "\n",
        "            # ترتيب حسب رقم الحلقة\n",
        "            if \"رقم الحلقة\" in كشف.columns:\n",
        "                كشف = كشف.sort_values(\n",
        "                    by=\"رقم الحلقة\",\n",
        "                    key=lambda col: col.astype(str),\n",
        "                    kind=\"stable\"\n",
        "                )\n",
        "\n",
        "            الأعمدة = [\n",
        "                \"اسم الطالب\", \"رقم الحلقة\",\n",
        "                \"اسم المعلم/المعلمة\"\n",
        "            ]\n",
        "\n",
        "            الأعمدة += المواد\n",
        "            الأعمدة += [\"المجموع\", \"النسبة %\", \"التقدير\"]\n",
        "\n",
        "            الأعمدة = [\n",
        "                عمود for عمود in الأعمدة\n",
        "                if عمود in كشف.columns\n",
        "            ]\n",
        "\n",
