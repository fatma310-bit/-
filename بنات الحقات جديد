        "max_scores = {\n",
        "    \"الدوري الأول\": 40,\n",
        "    \"نصف العام\": 100,\n",
        "    \"الدوري الثاني\": 40,\n",
        "    \"آخر العام\": 100,\n",
        "    \"التفسير الأول\": 20,\n",
        "    \"التفسير الثاني\": 20,\n",
        "    \"التجويد\": 20,\n",
        "    \"الغياب\": 10,\n",
        "    \"السلوك\": 10\n",
        "}\n",
        "\n",
        "المجموع_الكلي = sum(max_scores.values())\n",
        "\n",
        "def حساب_التقدير(النسبة):\n",
        "    if النسبة >= 90:\n",
        "        return \"ممتاز\"\n",
        "    elif النسبة >= 80:\n",
        "        return \"جيد جدًا\"\n",
        "    elif النسبة >= 70:\n",
        "        return \"جيد\"\n",
        "    elif النسبة >= 60:\n",
        "        return \"مقبول\"\n",
        "    else:\n",
        "        return \"يحتاج متابعة\"\n",
        "\n",
        "# إعادة حساب نتائج جميع الطلاب\n",
        "for index in students.index:\n",
        "    المجموع = sum(\n",
        "        students.loc[index, المادة]\n",
        "        for المادة in max_scores\n",
        "    )\n",
        "\n",
        "    النسبة = (المجموع / المجموع_الكلي) * 100\n",
        "\n",
        "    students.loc[index, \"المجموع\"] = المجموع\n",
        "    students.loc[index, \"النسبة %\"] = round(النسبة, 2)\n",
        "    students.loc[index, \"التقدير\"] = حساب_التقدير(النسبة)\n",
        "\n",
        "print(\"تم تحديث نظام النتائج بنجاح ✅\")\n",
        "print(\"المجموع الكلي:\", المجموع_الكلي)\n",
        "\n",
        "display(students)"
